# ─── EDEN OS Environment Variables ───

# Server
PORT=3000
NODE_ENV=development

# ─── Claude API ───
ANTHROPIC_API_KEY=sk-ant-...

# ─── Slack Bot Tokens (one per agent) ───
EDEN_BOT_TOKEN=xoxb-...
EDEN_SIGNING_SECRET=...
SCOUT_BOT_TOKEN=xoxb-...
SCOUT_SIGNING_SECRET=...
IRIS_BOT_TOKEN=xoxb-...
IRIS_SIGNING_SECRET=...
ATLAS_BOT_TOKEN=xoxb-...
ATLAS_SIGNING_SECRET=...
EMBER_BOT_TOKEN=xoxb-...
EMBER_SIGNING_SECRET=...
MUSE_BOT_TOKEN=xoxb-...
MUSE_SIGNING_SECRET=...
FORGE_BOT_TOKEN=xoxb-...
FORGE_SIGNING_SECRET=...
LENS_BOT_TOKEN=xoxb-...
LENS_SIGNING_SECRET=...
# Internal ops channel ID — Lens's weekly all-clients report goes ONLY here,
# never to a client's own Slack channel. Lens's bot must be a member.
LENS_OPS_CHANNEL=C...
NOVA_BOT_TOKEN=xoxb-...
NOVA_SIGNING_SECRET=...

# ─── GoHighLevel ───
GHL_API_KEY=...
GHL_3PCT_LOCATION_ID=...

# ─── Meta Ads ───
META_ACCESS_TOKEN=...
META_3PCT_AD_ACCOUNT_ID=act_...

# ─── Vapi (Phase 2 — Voice ISA) ───
VAPI_API_KEY=...
# Number Vapi dials FROM — must be imported from Twilio/Vonage/Telnyx into
# Vapi first; Vapi's free numbers can't place outbound calls.
VAPI_PHONE_NUMBER_ID=...
# Shared secret Vapi sends back as the X-Vapi-Secret header on every webhook
# call — set the same value in the assistant's server.secret (or a Custom
# Credential) in the Vapi dashboard. Without this, anyone who finds the
# webhook URL could POST fake call results into GHL.
VAPI_WEBHOOK_SECRET=...
# Where Vapi POSTs call events (end-of-call-report, etc). Point this at
# https://<your-render-domain>/webhooks/vapi in the assistant config.
VAPI_SERVER_URL=...
# Model/voice provider strings, NOT hardcoded in code — Vapi's accepted
# provider/model/voice values change over time, and a guessed-but-wrong
# value here would typecheck fine and fail at call time. Confirm current
# values in the Vapi dashboard before the first real test call.
VAPI_MODEL_PROVIDER=...
VAPI_MODEL_NAME=...
VAPI_VOICE_PROVIDER=...
VAPI_VOICE_ID=...

# ─── Nanobanana (Creative Generation) ───
NANOBANANA_API_KEY=...
